DATABASE_URL=postgres://ari:ari@localhost:5433/ari

# 32-byte base64 key: openssl rand -base64 32. must match the web app on a shared database
TOKEN_ENC_KEY=

PORT=8080

# shared secret for the /internal/* endpoints the web app calls (WEBHOOKS_INTERNAL_TOKEN there).
# blank rejects every internal call with 401
INTERNAL_API_TOKEN=

# which parts this process runs. all default to true
# SERVE_HTTP=true
# RUN_OUTBOX=true
# RUN_JOBS=true

# hackatime time capture (optional). blank key or url: ships are captured without tracked time
HACKATIME_BASE_URL=
HACKATIME_ADMIN_KEY=

# lapse timelapse capture (optional). blank key or url: no clips are read
LAPSE_BASE_URL=
LAPSE_API_KEY=

# reviewer vm cleanup (optional). blank token or url: the vm sweep does nothing
VM_API_BASE=
VM_API_TOKEN=

# github api proxy (optional). with both set, repositories on github are read through the proxy,
# which holds the github tokens: commits with line counts, file sizes, and no clone. either one
# blank: github is cloned like every other host
GH_PROXY_URL=
GH_PROXY_API_KEY=

# git capture tuning
# GIT_CLONE_CONCURRENCY=1
# GIT_CLONE_TIMEOUT_SECONDS=300
# JOB_WORKERS=2

# sentry (optional)
SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
